# Gemini API Key (TUYỆT ĐỐI KHÔNG COMMIT KEY THẬT LÊN GIT)
GEMINI_API_KEY=your_gemini_api_key_here

# (Tùy chọn) Nhiều key Gemini phân tách bằng dấu phẩy — app tự xoay vòng
# key khi 1 key hết hạn mức (429/RESOURCE_EXHAUSTED), đợi key đó reset rồi
# mới thử lại. Nếu để trống, app dùng lại đúng 1 GEMINI_API_KEY ở trên.
GEMINI_API_KEYS=

# (Tùy chọn) DeepSeek API Key — dùng cho tài khoản ĐÃ TRẢ PHÍ (FREE vẫn
# dùng Gemini free ở trên). Nếu để trống, tài khoản trả phí tự rơi về
# dùng Gemini như tài khoản free.
DEEPSEEK_API_KEY=

# Database Connection (SQLite local by default)
DATABASE_URL="file:./dev.db"

# URL gốc thật của web (dùng để build link xác minh email gửi qua Brevo).
# Nếu bỏ trống, server tự suy ra từ Host header của request lúc đăng ký.
APP_URL=https://sumflow.online

# Thư mục lưu video/asset AI sinh ra lúc runtime (KHÔNG phải public/) — sản
# xuất trỏ vào named volume Docker (xem docker-compose.yml), local dev để
# trống thì tự fallback về .video-storage/ trong repo (xem src/lib/media/storage.ts).
VIDEO_STORAGE_DIR=

# Nhà cung cấp sinh ảnh cho Tier Hybrid: "pollinations" (MIỄN PHÍ, không
# cần key), "fal" (fal.ai, model Janus-Pro — cần FAL_API_KEY đã nạp tiền),
# hoặc "gemini" (dùng key Google thật — cần bật billing Google Cloud HOẶC
# cấu hình GEMINI_PROXY_API_KEY/GEMINI_PROXY_BASE_URL bên dưới để đi qua
# proxy bên thứ 3). Mặc định "pollinations".
IMAGE_PROVIDER=pollinations
FAL_API_KEY=

# (Tùy chọn) Proxy Gemini bên thứ 3 (VD shopaikey.com) — chỉ áp dụng khi
# IMAGE_PROVIDER=gemini. Key RIÊNG, KHÔNG dùng chung bể GEMINI_API_KEYS
# (chat/TTS) vì định dạng key khác (sk-...), tránh lẫn vào rotation pool
# chính gây lỗi auth ở các tính năng đang chạy ổn định.
GEMINI_PROXY_API_KEY=
GEMINI_PROXY_BASE_URL=https://direct.shopaikey.com

# Giọng đọc AI cho video: "gemini" (mặc định, key Google thật, free tier có
# giới hạn/phút) hoặc "minimax" (qua đúng GEMINI_PROXY_API_KEY ở trên,
# endpoint /tts/minimax/t2a_v2 — dùng khi Gemini free-tier bị giới hạn quá
# thường xuyên).
TTS_PROVIDER=gemini
